# Raw downloads — hundreds of MB, all reproducible via pipeline/download.py
data/raw/
data/_raw_real/
data/raw_fixture/

# Build intermediates and test output
data/build/
data/reduced/
*.part
*.cursor

# Git bundles and commit-message scratch files
*.bundle
COMMIT_MSG.txt

# Generated by pipeline/bundle.py — 1.5 MB each, rebuildable
web/proteindle.html
web/proteindle.artifact.html

# web/data/*.json is deliberately NOT ignored: it is the deployable
# artifact, and a static host needs it in the repo.
#
# Nor is data/schedule.json. It is the published puzzle calendar — the one
# file here that cannot be regenerated, because it records which protein
# people have already played on which day.

__pycache__/
*.pyc
.DS_Store
.venv/
venv/
node_modules/
.vscode/
.idea/
